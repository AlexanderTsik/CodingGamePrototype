[node name="InstructionsLabel" type="Label" parent="HowToPlayPopup/MarginContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.55, 0.68, 0.60, 1)
theme_override_font_sizes/font_size = 13
text = "Guide the ladybug to the green goal tile by writing code.

Movement:
  move()       — move one cell forward
  turnRight()  — turn 90° clockwise
  turnLeft()   — turn 90° counter-clockwise
  turnBack()   — turn 180°

Sensors:
  frontIsClear()   — true if the front cell is walkable
  leftIsClear()    — true if the left cell is walkable
  rightIsClear()   — true if the right cell is walkable
  goalReached()    — true if standing on the goal
  onHazard()       — true if standing on a hazard

Control flow:
  if (condition) { }
  for (i in range(n)) { }
  while (condition) { }
  function name() { }

Goal tile is green.  Hazard tiles are red — avoid them!

Example:
  while (frontIsClear()) {
      move()
  }
  turnRight()
  move()"
autowrap_mode = 3

